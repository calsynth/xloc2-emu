+// DevSlot — hot development slot for the XLOC2 emulator.
+//
+// WHY THIS EXISTS
+// ---------------
+// Every applet header is #included into applets/_config.h, which is #included
+// into OC_apps.cpp. That makes OC_apps.cpp a ~63,000-line translation unit, so
+// touching ANY applet costs a full 34-second rebuild of it.
+//
+// DevSlot breaks that chain. It is a thin proxy: it appears in the applet
+// browser as "Dev", but every call is forwarded to an applet implemented in
+// dev/DevApplet.cpp — a separate, small translation unit OUTSIDE the firmware
+// tree. Editing your applet there recompiles one file and relinks (~2 s)
+// instead of rebuilding OC_apps.cpp.
+//
+// DO NOT EDIT THIS FILE while iterating on an applet. It is included by
+// _config.h, so any change here brings the 34-second rebuild back. Everything
+// you want to change lives in dev/DevApplet.cpp.
+//
+// NOTE: this header is included by _config.h BEFORE the applet_name /
+// applet_icon rewriting macros are defined, so the name/icon members here are
+// written out in full rather than relying on that hack.
+#pragma once
+
+// Implemented in dev/DevApplet.cpp (added to the build by the top-level
+// CMakeLists.txt, not by the firmware source glob).
+HemisphereApplet* xloc_dev_applet_create();
+// SetHelp() is protected on the base class, so it cannot be reached through a
+// HemisphereApplet*. dev/DevApplet.cpp declares its own SetHelp() public and
+// exposes it through this shim.
+void xloc_dev_applet_set_help(HemisphereApplet*);
+
+class DevSlot : public HemisphereApplet {
+public:
+    // The applet browser lists the registry's static name, so this slot always
+    // shows up as "Dev" wherever you left it. The on-screen header, though,
+    // asks the live instance — so it shows whatever your applet calls itself.
+    static constexpr const char* applet_name_() { return "Dev"; }
+    static constexpr const uint8_t* applet_icon_() { return ZAP_ICON; }
+
+    const char* applet_name() const override {
+        return impl ? impl->applet_name() : "Dev";
+    }
+    const uint8_t* applet_icon() const override {
+        return impl ? impl->applet_icon() : ZAP_ICON;
+    }
+
+    void Start() override            { if (Sync()) impl->Start(); }
+    void Reset() override            { if (Sync()) impl->Reset(); }
+    void Controller() override       { if (Sync()) impl->Controller(); }
+    void View() override             { if (Sync()) impl->View(); else Placeholder(); }
+    void DrawFullScreen() override   { if (Sync()) impl->DrawFullScreen(); else Placeholder(); }
+    void OnButtonPress() override    { if (Sync()) impl->OnButtonPress(); }
+    void AuxButton() override        { if (Sync()) impl->AuxButton(); }
+    void OnEncoderMove(int d) override { if (Sync()) impl->OnEncoderMove(d); }
+    void Unload() override           { if (Sync()) impl->Unload(); }
+    uint64_t OnDataRequest() override { return Sync() ? impl->OnDataRequest() : 0; }
+    void OnDataReceive(uint64_t v) override { if (Sync()) impl->OnDataReceive(v); }
+    void SetHelp() override          { if (Sync()) xloc_dev_applet_set_help(impl); }
+
+private:
+    // One implementation instance per slot, created on first use. The registry
+    // makes a DevSlot per (applet, hemisphere) pair, so each gets its own.
+    HemisphereApplet* impl = xloc_dev_applet_create();
+
+    // Keep the implementation's idea of which hemisphere it is drawing into in
+    // step with ours. Everything else an applet reads (cursor state, help
+    // labels, preset id, the IO frame) is static or global, so this is the
+    // only per-instance state that has to be mirrored.
+    bool Sync() {
+        if (!impl) return false;
+        impl->SetDisplaySide(hemisphere);
+        return true;
+    }
+
+    void Placeholder() {
+        gfxPrint(1, 15, "dev applet");
+        gfxPrint(1, 25, "not built");
+    }
+};
